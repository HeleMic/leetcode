{
  "method": "twoSum",
  "normalizer": "sort",
  "cases": [
    {
      "label": "Example 1 — answer at start",
      "args": [[2, 7, 11, 15], 9],
      "expected": [0, 1]
    },
    {
      "label": "Example 2 — answer in middle",
      "args": [[3, 2, 4], 6],
      "expected": [1, 2]
    },
    {
      "label": "Example 3 — duplicate values",
      "args": [[3, 3], 6],
      "expected": [0, 1]
    },
    {
      "label": "Answer at the end of the array",
      "args": [[1, 5, 3, 8, 2], 10],
      "expected": [3, 4]
    },
    {
      "label": "Minimum size array (2 elements)",
      "args": [[100, 200], 300],
      "expected": [0, 1]
    },
    {
      "label": "Both negative numbers",
      "args": [[-1, -2, -3, -4, -5], -8],
      "expected": [2, 4]
    },
    {
      "label": "Mixed positive and negative",
      "args": [[-3, 4, 3, 90], 0],
      "expected": [0, 2]
    },
    {
      "label": "Target is zero with negatives",
      "args": [[-10, 5, 10, -5, 2], 0],
      "expected": [0, 2]
    },
    {
      "label": "Large values",
      "args": [[999999999, 1, 500000000, -999999999], 0],
      "expected": [0, 3]
    },
    {
      "label": "Single pair among many elements",
      "args": [[10, 20, 30, 40, 5, 95], 100],
      "expected": [4, 5]
    },
    {
      "label": "Complement is earlier in the array",
      "args": [[5, 1, 7, 3, 9], 4],
      "expected": [1, 3]
    },
    {
      "label": "Zero in the array",
      "args": [[0, 4, 3, 0], 0],
      "expected": [0, 3]
    }
  ]
}
