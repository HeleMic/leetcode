{
  "method": "findMedianSortedArrays",
  "cases": [
    {
      "label": "Example 1 — Odd total length",
      "args": [[1, 3], [2]],
      "expected": 2.0
    },
    {
      "label": "Example 2 — Even total length",
      "args": [
        [1, 2],
        [3, 4]
      ],
      "expected": 2.5
    },
    {
      "label": "One array empty, odd length",
      "args": [[], [1]],
      "expected": 1.0
    },
    {
      "label": "One array empty, even length",
      "args": [[1, 2, 3, 4], []],
      "expected": 2.5
    },
    {
      "label": "Identical arrays",
      "args": [
        [1, 2],
        [1, 2]
      ],
      "expected": 1.5
    },
    {
      "label": "No overlap — nums1 < nums2",
      "args": [
        [1, 2],
        [3, 4, 5]
      ],
      "expected": 3.0
    },
    {
      "label": "No overlap — nums1 > nums2",
      "args": [
        [10, 20],
        [1, 2, 3, 4]
      ],
      "expected": 3.5
    },
    {
      "label": "Arrays with same values",
      "args": [
        [1, 1],
        [1, 1]
      ],
      "expected": 1.0
    },
    {
      "label": "Single elements",
      "args": [[1], [3]],
      "expected": 2.0
    },
    {
      "label": "Large overlap",
      "args": [
        [1, 5, 8],
        [2, 3, 6, 7]
      ],
      "expected": 5.0
    }
  ]
}
